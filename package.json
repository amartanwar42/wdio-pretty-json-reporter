{
  "name": "wdio-pretty-json-reporter",
  "version": "1.0.5",
  "description": "CTRF JSON reporter for WebdriverIO with auto-capture service, hooks, retries, and attachments.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellobetter/wdio-pretty-json-reporter"
  },
  "homepage": "https://github.com/hellobetter/wdio-pretty-json-reporter#readme",
  "bugs": {
    "url": "https://github.com/hellobetter/wdio-pretty-json-reporter/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./reporter": {
      "import": "./dist/reporter.js",
      "require": "./dist/reporter.js",
      "types": "./dist/reporter.d.ts"
    },
    "./service": {
      "import": "./dist/service.js",
      "require": "./dist/service.js",
      "types": "./dist/service.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "reporter",
    "ctrf",
    "json",
    "appium",
    "mocha",
    "typescript",
    "test-report",
    "e2e",
    "mobile-testing",
    "attachment",
    "screenshot"
  ],
  "author": "amar <amartanwar42@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@wdio/reporter": ">=8.0.0",
    "@wdio/types": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
